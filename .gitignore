# ==========================================
# Python Rules
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Rope project settings
.ropeproject

# Django / Flask / FastAPI stuff
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Local SQLite database
*.db

# ==========================================
# React / Node.js Frontend Rules
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Production builds (Vite, Next.js, CRA)
dist/
build/
out/
.next/

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Frontend bundler cache
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional npm cache directory
.npm

# ==========================================
# Shared Environments & Secrets
# ==========================================

# Virtual environments
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/

# Application logs
logs/

# ==========================================
# IDE & System Files
# ==========================================

# Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# OS metadata
.DS_Store
Thumbs.db